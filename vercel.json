{
  "functions": {
    "api/generate-novena-pdf.js": {
      "maxDuration": 60,
      "memory": 1536
    },
    "api/quiz-result.js": {
      "maxDuration": 60
    },
    "api/quiz-checkout.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path":     "/api/send-quiz-drip",
      "schedule": "0 10 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "destination": "https://www.espiritualizei.com/:path*",
      "has": [{ "type": "host", "value": "espiritualizei.com" }],
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/sw.js", "destination": "/sw.js" },
    { "source": "/manifest.json", "destination": "/manifest.json" },
    { "source": "/favicon.ico", "destination": "/favicon.ico" },
    { "source": "/quiz", "destination": "/quiz/index.html" },
    { "source": "/quiz/resultado", "destination": "/quiz/resultado.html" },
    { "source": "/quiz/:path*", "destination": "/quiz/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/quiz",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/quiz/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/quiz/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript" },
        { "key": "Service-Worker-Allowed", "value": "/" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
